# Comma-separated allowed CORS origins
CORS_ORIGINS=http://localhost:5173

# Firebase Admin credentials — file path or raw JSON (required; auth is always enabled)
FIREBASE_CREDENTIALS_JSON=./firebase_credentials.json

# API key for running the AI models
OPENAI_API_KEY=

# Stripe — use test keys (sk_test_...) for local dev
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Frontend origin used for Stripe success/cancel redirect URLs.
# Defaults to the first CORS_ORIGINS entry if unset.
APP_URL=http://localhost:5173
