# Set to "true" to bypass Firebase auth (dev only)
AUTH_DISABLED=false

# Comma-separated allowed CORS origins
CORS_ORIGINS=http://localhost:5173

# Ko-fi webhook verification token (from Ko-fi developer settings)
KOFI_VERIFICATION_TOKEN=your_kofi_verification_token_here

# Set to "true" to stub all AI model calls (10 s delay, no API tokens consumed)
AI_SWITCH_STUB=false
